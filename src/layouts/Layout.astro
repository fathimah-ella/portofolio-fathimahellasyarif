---
import '../styles/global.css';

const { titleId, titleEn, descriptionEn } = Astro.props;
---

<!doctype html>
<html lang="en" data-lang="en" data-title-id={titleId} data-title-en={titleEn}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titleEn}</title>
    <meta name="description" content={descriptionEn} />
    <meta property="og:title" content={titleEn} />
    <meta property="og:description" content={descriptionEn} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#f5f8ff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;1,9..144,300;1,9..144,400&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <!-- Mengatur bahasa sebelum halaman tampil, supaya tidak berkedip -->
    <script is:inline>
      (function () {
        try {
          var l = localStorage.getItem('lang');
          if (l === 'id' || l === 'en') {
            document.documentElement.setAttribute('data-lang', l);
            document.documentElement.lang = l;
            var t = document.documentElement.getAttribute('data-title-' + l);
            if (t) document.title = t;
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <slot />
    <script is:inline src="/scripts/main.js" defer></script>
  </body>
</html>
